{
  "manifest_version": 3,
  "name": "Wardkin",
  "version": "0.1.0",
  "description": "Block distracting websites and stay focused.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Wardkin",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["images/gargou.png"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
